# mako — thème sombre Adwaita
# doc : man 5 mako   |  recharger : makoctl reload

font=Adwaita Sans 11
background-color=#242424f0
text-color=#ffffffff
border-color=#ffffff1a
border-size=1
border-radius=12
progress-color=over #3584e440

width=400
height=180
padding=14,16
margin=8
outer-margin=14

icons=1
max-icon-size=48
icon-location=left
icon-border-radius=8

markup=1
actions=1
format=<b>%s</b>\n%b
text-alignment=left

default-timeout=5000
max-visible=5
group-by=app-name
history=1
max-history=50
sort=-time

layer=overlay
anchor=top-right

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

# --- notifications groupées (plusieurs d'une même app) ---
[grouped]
format=<b>%s</b> <span foreground="#9a9996">(%g)</span>\n%b

# --- niveaux d'urgence ---
[urgency=low]
background-color=#242424e0
text-color=#c0bfbcff
border-color=#ffffff12
default-timeout=3000

[urgency=normal]
border-color=#ffffff1a

[urgency=critical]
background-color=#2b1416f5
text-color=#ffffffff
border-color=#e01b24cc
default-timeout=0
